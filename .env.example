# BestMac Environment Variables
# Скопируйте этот файл в .env и заполните реальными значениями

# ─── Prerender.io ─────────────────────────────────────────────────
# Токен для pre-rendering SPA для поисковых ботов
# Получите бесплатный токен на https://prerender.io (250 страниц/мес)
PRERENDER_TOKEN=

# ─── Google Analytics 4 ──────────────────────────────────────────
# Замените на реальный Measurement ID из GA4
# GA4_MEASUREMENT_ID=G-XXXXXXXXXX

# ─── Supabase (если используется) ────────────────────────────────
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=

# ─── Intake-контур коллектора (GST-10) ───────────────────────────
# Общий токен приёмника карточек. Должен совпадать в 3 местах:
# Vercel env, VPS .env, попап расширения. Идёт в заголовке x-intake-token поверх TLS.
INTAKE_TOKEN=
# HTTPS-URL VPS-приёмника (за Caddy). На Vercel-стороне форварда.
INTAKE_VPS_URL=https://intake.bestmac.ru/intake
# Allowlist CORS для /api/intake (origin страницы, где работает расширение).
# По умолчанию https://www.avito.ru,https://m.avito.ru — раскомментируй, чтобы переопределить.
# INTAKE_ALLOWED_ORIGINS=https://www.avito.ru,https://m.avito.ru
# VPS-сервер слушает этот host (по умолчанию 127.0.0.1, за Caddy). Наружу порт не открываем.
# INTAKE_HOST=127.0.0.1

# ─── Avito API (OAuth2) ──────────────────────────────────────────
# Ключи приложения Avito. НЕ коммитить реальные значения — только сюда
# как пустые плейсхолдеры; реальные в .env.local / Secrets CI / VPS.
# Кабинет разработчика: https://developers.avito.ru
VITE_AVITO_CLIENT_ID=
VITE_AVITO_CLIENT_SECRET=
VITE_AVITO_REDIRECT_URL=https://bestmac.ru
