{
  "manifest_version": 3,
  "name": "BestMac Avito Collector",
  "version": "1.9.0",
  "description": "Собирает новые объявления Mac и фильтров из бота с Avito (на домашнем браузере) и шлёт на BestMac.",
  "permissions": [
    "storage",
    "tabs",
    "alarms",
    "notifications"
  ],
  "host_permissions": [
    "*://www.avito.ru/*",
    "https://bestmac.ru/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://www.avito.ru/*noutbuki*",
        "*://www.avito.ru/*nastolnye_kompyutery*",
        "*://www.avito.ru/*avtomobili*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "BestMac Collector — открыть"
  }
}
